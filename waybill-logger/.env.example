# Copy this file to .env and fill in your key. Never share .env.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# PIN that every phone/PC must enter before using the app. Strongly recommended
# whenever other devices can reach the server; required on Render.
# ACCESS_PIN=choose-a-6+-digit-pin
# SESSION_SECRET=any-long-random-text  # keeps devices signed in across restarts

# Optional settings
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=high            # low | medium | high | xhigh | max (higher = more careful, slower, costlier)
# PORT=3000
# HOST=0.0.0.0                  # use 127.0.0.1 to block phones/other PCs on the network
# DATA_DIR=./data               # where settings, history and photos are stored
# MOCK_EXTRACTION=1             # demo mode: no API calls, every photo returns a sample waybill
